; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://FMODBanks/Desktop"

[application]

config/name="Paddle game"
run/main_scene="uid://brkn643u64djv"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SensorInput="*res://Scripts/sensor_input.gd"
HandTracking="*uid://d2blqpvsn7td8"
FmodManager="*uid://cds10pm7hwn3p"
FmodBankLoaderGlobal="*uid://dtrisfc510g5w"
MusicManager="*uid://c7aksus6kmxnp"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Paddle game"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg", "res://addons/gdserial/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
global_illumination/gi/use_half_resolution=true
anti_aliasing/quality/msaa_3d=1
environment/volumetric_fog/volume_size=128
